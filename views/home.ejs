<%- include('partials/layoutStart') %>
<main class="page-container">
  <section class="home-hero">
    <div class="hero-copy">
      <span class="eyebrow">YOUR PERSONAL STUDY COMPANION</span>
      <h1>Find the right learning resources for your study</h1>
      <p>Discover curated tutorials, articles, documentation and other learning materials based on your subject, keywords and difficulty level.</p>
    </div>
    <div class="hero-illustration" aria-hidden="true">
      <i class="bi bi-mortarboard-fill"></i>
      <i class="bi bi-book-half"></i>
      <i class="bi bi-laptop"></i>
    </div>
  </section>

  <section class="soft-card get-started-card" aria-labelledby="get-started-heading">
    <h2 id="get-started-heading">Get Started</h2>
    <p class="section-subtitle">Select your preferences and get personalized learning resources.</p>
    <form class="resource-search-form" action="/resources" method="get">
      <div class="row g-3">
        <div class="col-md-4">
          <label class="form-label" for="homeSubject">Subject</label>
          <select class="form-select" id="homeSubject" name="subject">
            <option value="">Any subject</option>
            <option>Mathematics</option><option>Web Development</option><option>Programming</option>
            <option>Computer Science</option><option>Academic Skills</option>
          </select>
        </div>
        <div class="col-md-4">
          <label class="form-label" for="homeKeyword">Keyword or Topic</label>
          <input class="form-control" id="homeKeyword" name="keyword" type="search" placeholder="e.g. algebra">
        </div>
        <div class="col-md-4">
          <label class="form-label" for="homeDifficulty">Difficulty Level</label>
          <select class="form-select" id="homeDifficulty" name="difficulty">
            <option value="">Any level</option><option>Beginner</option><option>Intermediate</option><option>Advanced</option>
          </select>
        </div>
      </div>
      <button class="btn btn-primary w-100 mt-4" type="submit"><i class="bi bi-search me-2" aria-hidden="true"></i>Get Recommendations</button>
    </form>
  </section>

  <section class="recommendations-section" aria-labelledby="recommendations-heading">
    <div class="recommendations-heading">
      <div>
        <h2 id="recommendations-heading">Recommended for You</h2>
        <p>Based on your recent searches.</p>
      </div>
      <a class="btn btn-outline-success btn-sm" href="/resources">Browse all resources</a>
    </div>
    <div id="homeRecommendationsLoading" class="state-card recommendation-state">
      <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>Loading recommendations...
    </div>
    <div id="homeRecommendationsError" class="alert alert-danger" role="alert" hidden>
      Recommendations are temporarily unavailable. Please try again later.
    </div>
    <div id="homeRecommendationsEmpty" class="state-card recommendation-state" hidden>
      <i class="bi bi-book empty-icon" aria-hidden="true"></i>
      <h2>No recommendations yet</h2>
      <p>Complete a search to personalize this panel. Beginner-friendly resources will appear here in the meantime.</p>
    </div>
    <div id="homeRecommendations" class="recommendation-grid" hidden></div>
  </section>

  <section class="examples-section" aria-labelledby="examples-heading">
    <h2 id="examples-heading" class="section-heading">Example topics</h2>
    <div class="topic-buttons">
      <a href="/resources?keyword=Subnetting" class="btn btn-outline-secondary">Subnetting</a>
      <a href="/resources?keyword=HTML+Forms" class="btn btn-outline-secondary">HTML Forms</a>
      <a href="/resources?keyword=Cloud+Basics" class="btn btn-outline-secondary">Cloud Basics</a>
      <a href="/resources?keyword=Linux+Commands" class="btn btn-outline-secondary">Linux Commands</a>
    </div>
  </section>

  <section class="how-section" aria-labelledby="how-heading">
    <h2 id="how-heading" class="section-heading">How it works</h2>
    <div class="row g-3">
      <div class="col-lg-4"><article class="step-card"><span class="step-icon"><i class="bi bi-sliders2"></i></span><div><h3>1. Select your preferences</h3><p>Choose a subject, enter a topic and select your difficulty level.</p></div></article></div>
      <div class="col-lg-4"><article class="step-card"><span class="step-icon"><i class="bi bi-search"></i></span><div><h3>2. Get relevant resources</h3><p>Our system finds learning materials matching your search criteria.</p></div></article></div>
      <div class="col-lg-4"><article class="step-card"><span class="step-icon"><i class="bi bi-book"></i></span><div><h3>3. Start learning</h3><p>Open the resources and build your knowledge at your own pace.</p></div></article></div>
    </div>
  </section>
  <%- include('partials/footer') %>
</main>
<%- include('partials/layoutEnd', { pageScript: '/js/home.js' }) %>
