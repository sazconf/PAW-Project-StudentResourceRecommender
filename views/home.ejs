<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="Find learning resources matched to your study needs.">
    <title><%= pageTitle %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="/css/style.css" rel="stylesheet">
  </head>
  <body class="d-flex flex-column min-vh-100 bg-light">
    <%- include('partials/navbar') %>

    <main class="container flex-grow-1 py-5">
      <section class="hero-section text-center mb-5">
        <span class="badge text-bg-primary mb-3">Learn with confidence</span>
        <h1 class="display-5 fw-bold">Smart Student Resource Recommender</h1>
        <p class="lead text-secondary mx-auto intro-text">
          Discover useful learning materials based on your subject, interests, and current skill level.
        </p>
      </section>

      <section class="card border-0 shadow-sm mb-5" aria-labelledby="search-heading">
        <div class="card-body p-4 p-md-5">
          <h2 id="search-heading" class="h4 mb-4">Find a learning resource</h2>
          <form action="#" method="get">
            <div class="row g-3">
              <div class="col-md-4">
                <label class="form-label" for="subject">Subject</label>
                <input class="form-control" id="subject" name="subject" type="text" placeholder="e.g. Mathematics">
              </div>
              <div class="col-md-4">
                <label class="form-label" for="keyword">Keyword</label>
                <input class="form-control" id="keyword" name="keyword" type="search" placeholder="e.g. algebra">
              </div>
              <div class="col-md-4">
                <label class="form-label" for="difficulty">Difficulty</label>
                <select class="form-select" id="difficulty" name="difficulty">
                  <option value="">Any level</option>
                  <option>Beginner</option>
                  <option>Intermediate</option>
                  <option>Advanced</option>
                </select>
              </div>
              <div class="col-12">
                <button class="btn btn-primary px-4" type="submit">Search resources</button>
              </div>
            </div>
          </form>
        </div>
      </section>

      <section aria-labelledby="recommendations-heading">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
          <div>
            <h2 id="recommendations-heading" class="h4 mb-1">Recommended resources</h2>
            <p class="text-secondary mb-0">Your personalized recommendations will appear here.</p>
          </div>
          <span class="badge rounded-pill text-bg-light border">Coming soon</span>
        </div>
        <div class="empty-state rounded-3 text-center p-5">
          <h3 class="h5">No recommendations yet</h3>
          <p class="text-secondary mb-0">Use the search form above when the recommendation engine is connected.</p>
        </div>
      </section>
    </main>

    <%- include('partials/footer') %>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
