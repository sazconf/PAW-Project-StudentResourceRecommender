<button class="chatbot-launcher" type="button" aria-label="Open Study Assistant" aria-controls="chatbotPanel" aria-expanded="false" title="Study Assistant">
  <i class="bi bi-chat-dots-fill" aria-hidden="true"></i>
</button>
<section class="chatbot-panel" id="chatbotPanel" aria-label="Study Assistant" hidden>
  <header class="chatbot-header">
    <div><strong>Study Assistant</strong><small>Ask about learning resources</small></div>
    <button class="chatbot-close" type="button" aria-label="Close Study Assistant"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
  </header>
  <div class="chatbot-messages" aria-live="polite">
    <p class="chatbot-empty">Open the full assistant to ask questions and receive resource recommendations.</p>
  </div>
  <a class="btn btn-primary chatbot-open-link" href="/assistant">Open AI Assistant</a>
</section>
