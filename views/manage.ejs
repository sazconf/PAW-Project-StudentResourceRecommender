<%- include('partials/layoutStart') %>
<main class="page-container">
  <header class="page-header d-flex flex-wrap justify-content-between align-items-center gap-3">
    <div>
      <span class="eyebrow">ADMINISTRATION &amp; CATALOG</span>
      <h1>Manage Resources</h1>
      <p>Create, update, and manage persistent learning materials stored in PostgreSQL.</p>
    </div>
    <button class="btn btn-primary" type="button" data-bs-toggle="modal" data-bs-target="#resourceModal" id="openAddModalBtn">
      <i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Add Resource
    </button>
  </header>

  <!-- Live Toast Notification Container -->
  <div id="alertContainer" class="mb-3"></div>

  <!-- Quick Filter & Summary Toolbar -->
  <section class="soft-card mb-4" aria-label="Catalog filters">
    <div class="row g-3 align-items-center">
      <div class="col-md-5">
        <div class="input-group">
          <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
          <input type="search" id="manageSearchInput" class="form-control border-start-0" placeholder="Filter by title, subject, or keyword...">
        </div>
      </div>
      <div class="col-md-3">
        <select id="manageSubjectFilter" class="form-select">
          <option value="">All Subjects</option>
          <option>Mathematics</option>
          <option>Web Development</option>
          <option>Programming</option>
          <option>Computer Science</option>
          <option>Academic Skills</option>
        </select>
      </div>
      <div class="col-md-2">
        <select id="manageDifficultyFilter" class="form-select">
          <option value="">All Difficulties</option>
          <option>Beginner</option>
          <option>Intermediate</option>
          <option>Advanced</option>
        </select>
      </div>
      <div class="col-md-2 text-md-end">
        <button id="refreshTableBtn" class="btn btn-outline-secondary w-100" type="button" title="Reload from database">
          <i class="bi bi-arrow-clockwise me-1"></i>Refresh
        </button>
      </div>
    </div>
  </section>

  <!-- States -->
  <div id="manageLoadingState" class="state-card" hidden>
    <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
    Connecting to PostgreSQL database...
  </div>

  <div id="manageErrorState" class="alert alert-danger" role="alert" hidden>
    <i class="bi bi-exclamation-triangle-fill me-2"></i>
    <span id="manageErrorMessage">Failed to load resources from database.</span>
  </div>

  <div id="manageEmptyState" class="state-card" hidden>
    <i class="bi bi-inbox empty-icon" aria-hidden="true"></i>
    <h2>No resources found</h2>
    <p>There are no learning resources matching your current criteria in the database.</p>
    <button class="btn btn-primary btn-sm mt-2" type="button" data-bs-toggle="modal" data-bs-target="#resourceModal" id="emptyAddBtn">
      <i class="bi bi-plus-lg me-1"></i>Add the first resource
    </button>
  </div>

  <!-- Resource Table -->
  <section class="history-table-wrap mb-4" id="manageTableWrap">
    <div class="table-responsive">
      <table class="table history-table align-middle">
        <caption class="visually-hidden">PostgreSQL Learning Resources Catalog</caption>
        <thead>
          <tr>
            <th scope="col" style="width: 50px;">ID</th>
            <th scope="col" style="min-width: 200px;">Resource Title &amp; Description</th>
            <th scope="col">Subject</th>
            <th scope="col">Keywords</th>
            <th scope="col">Difficulty</th>
            <th scope="col">Type</th>
            <th scope="col">Link</th>
            <th scope="col" class="text-end" style="min-width: 130px;">Actions</th>
          </tr>
        </thead>
        <tbody id="manageTableBody">
          <!-- Dynamically populated by public/js/manage.js -->
        </tbody>
      </table>
    </div>
  </section>

  <!-- Footer counter -->
  <div class="d-flex justify-content-between align-items-center text-muted small px-1 mb-4">
    <span id="manageCountLabel">Loading records...</span>
    <span>Source: <strong>PostgreSQL</strong> (`resources` table)</span>
  </div>

  <%- include('partials/footer') %>
</main>

<!-- Add / Edit Resource Modal -->
<div class="modal fade" id="resourceModal" tabindex="-1" aria-labelledby="resourceModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header" style="background: var(--forest); color: #fff;">
        <h5 class="modal-title" id="resourceModalLabel">Add Learning Resource</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form id="resourceForm" novalidate>
        <div class="modal-body p-4">
          <!-- Validation alert inside modal -->
          <div id="modalFormAlert" class="alert alert-danger d-none" role="alert"></div>

          <!-- Hidden input for ID (when editing) -->
          <input type="hidden" id="modalResourceId" name="id" value="">

          <div class="row g-3">
            <div class="col-md-12">
              <label for="modalTitle" class="form-label">Resource Title <span class="text-danger">*</span></label>
              <input type="text" class="form-control" id="modalTitle" name="title" required placeholder="e.g. Master PostgreSQL Query Optimization" maxlength="255">
            </div>

            <div class="col-md-6">
              <label for="modalSubject" class="form-label">Subject <span class="text-danger">*</span></label>
              <select class="form-select" id="modalSubject" name="subject" required>
                <option value="">Select subject...</option>
                <option value="Mathematics">Mathematics</option>
                <option value="Web Development">Web Development</option>
                <option value="Programming">Programming</option>
                <option value="Computer Science">Computer Science</option>
                <option value="Academic Skills">Academic Skills</option>
              </select>
            </div>

            <div class="col-md-6">
              <label for="modalDifficulty" class="form-label">Difficulty Level <span class="text-danger">*</span></label>
              <select class="form-select" id="modalDifficulty" name="difficulty" required>
                <option value="">Select level...</option>
                <option value="Beginner">Beginner</option>
                <option value="Intermediate">Intermediate</option>
                <option value="Advanced">Advanced</option>
              </select>
            </div>

            <div class="col-md-6">
              <label for="modalResourceType" class="form-label">Resource Type <span class="text-danger">*</span></label>
              <select class="form-select" id="modalResourceType" name="resource_type" required>
                <option value="">Select type...</option>
                <option value="Video Tutorial">Video Tutorial</option>
                <option value="Article / Guide">Article / Guide</option>
                <option value="Interactive Lab">Interactive Lab</option>
                <option value="Documentation">Documentation</option>
                <option value="Book / eBook">Book / eBook</option>
                <option value="Course">Course</option>
              </select>
            </div>

            <div class="col-md-6">
              <label for="modalKeyword" class="form-label">Keywords / Topics <span class="text-danger">*</span></label>
              <input type="text" class="form-control" id="modalKeyword" name="keyword" required placeholder="e.g. postgres, sql, indexes, performance" maxlength="255">
            </div>

            <div class="col-md-12">
              <label for="modalUrl" class="form-label">Resource URL <span class="text-danger">*</span></label>
              <input type="url" class="form-control" id="modalUrl" name="url" required placeholder="https://example.com/resource">
            </div>

            <div class="col-md-12">
              <label for="modalDescription" class="form-label">Description</label>
              <textarea class="form-control" id="modalDescription" name="description" rows="3" placeholder="Provide a concise description of what the student will learn..."></textarea>
            </div>
          </div>
        </div>
        <div class="modal-footer bg-light">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary" id="saveResourceBtn">
            <span class="spinner-border spinner-border-sm me-1 d-none" id="saveSpinner" aria-hidden="true"></span>
            <span id="saveBtnText">Save Resource</span>
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header bg-danger text-white">
        <h5 class="modal-title" id="deleteModalLabel"><i class="bi bi-trash3 me-2"></i>Confirm Deletion</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body p-4">
        <p class="mb-2">Are you sure you want to delete this resource from PostgreSQL?</p>
        <div class="p-3 bg-light rounded border">
          <strong id="deleteTargetTitle" class="d-block text-dark"></strong>
          <small id="deleteTargetMeta" class="text-muted"></small>
        </div>
        <p class="text-danger small mt-2 mb-0"><i class="bi bi-exclamation-circle me-1"></i>This action permanently removes the record from the database.</p>
      </div>
      <div class="modal-footer bg-light">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-danger" id="confirmDeleteBtn">
          <span class="spinner-border spinner-border-sm me-1 d-none" id="deleteSpinner" aria-hidden="true"></span>
          Delete Permanently
        </button>
      </div>
    </div>
  </div>
</div>

<%- include('partials/layoutEnd', { pageScript: '/js/manage.js' }) %>
